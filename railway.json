{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/connectivity/Dockerfile",
    "watchPatterns": [
      "api/proto/computehop/connectivity/**",
      "cmd/computehop-connectivity/**",
      "deploy/connectivity/**",
      "gen/go/computehop/connectivity/**",
      "internal/connectivity/rendezvous/**",
      ".dockerignore",
      "go.mod",
      "go.sum",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 10
  }
}
